NODE_ENV=development
HOST=0.0.0.0
PORT=3000

DATABASE_PATH=./data/moonhaul.db
BACKUP_DIR=./backups
CHAT_PROVIDER=mock
RANDOM_SEED=

# Twitch EventSub WebSocket + Chat API (required only when CHAT_PROVIDER=twitch)
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
TWITCH_BROADCASTER_ID=
TWITCH_BOT_USER_ID=
TWITCH_ACCESS_TOKEN=
TWITCH_REFRESH_TOKEN=
# Broadcaster-owned token with channel:manage:broadcast. Optional when the bot and broadcaster are the same account.
TWITCH_BROADCAST_ACCESS_TOKEN=
TWITCH_BROADCAST_REFRESH_TOKEN=

ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me
SESSION_SECRET=change-me-now

# Use https://... when the admin panel is behind TLS; this also enables the secure admin session cookie.
PUBLIC_BASE_URL=http://localhost:3000

# Optional CPU-only Twitch stream worker
STREAM_ENABLED=false
TWITCH_STREAM_KEY=
STREAM_WIDTH=1280
STREAM_HEIGHT=720
STREAM_FPS=15
STREAM_BITRATE=1800k
